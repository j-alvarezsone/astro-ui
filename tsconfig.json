{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@/types/*": [
        "./src/share/types/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@web-components/*": [
        "./src/web-components/*"
      ],
      "@utils/*": [
        "./src/share/utils/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@content/*": [
        "./src/content/*"
      ]
    }
  }
}
