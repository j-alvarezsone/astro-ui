---
import type { IconProps } from 'astro-icon/components';
import { Icon } from 'astro-icon/components';
import type { ClassValue } from '@/types/theme/form/shared';

interface Props {
  href: string;
  label?: string;
  icon?: IconProps;
  target?: string;
  rel?: string;
  class?: ClassValue;
}

const { href, label, icon, target, rel, class: className, ...rest } = Astro.props;

const { pathname, search } = Astro.url;
const currentPath = `${pathname}${search}`;

const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={['nav-link', { 'nav-link--active': isActive }, className]}
  aria-current={isActive ? 'page' : undefined}
  {...rest}
>
  {isActive && <span transition:name="active-link" class="nav-link__active" aria-hidden="true" />}
  {icon && <Icon {...icon} class="nav-link__icon" aria-hidden="true" />}
  <span class="nav-link__label">
    <slot>{label}</slot>
  </span>
</a>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: 2.75rem;
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--rounded-lg);
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--color-fg-muted);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
    position: relative;
    isolation: isolate;
  }

  .nav-link--active {
    color: var(--color-primary-fg);
  }

  .nav-link:hover {
    background-color: color-mix(in srgb, var(--color-primary-subtle) 82%, white);
    border-color: color-mix(in srgb, var(--color-primary-border) 22%, transparent);
    box-shadow: 0 0.375rem 1rem color-mix(in srgb, var(--color-primary-focus-ring) 16%, transparent);
    color: var(--color-primary-fg);
    transform: translateY(-1px);
  }

  .nav-link__active {
    position: absolute;
    inset: 0;
    border-radius: var(--rounded-lg);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary-subtle) 84%, white),
      color-mix(in srgb, var(--color-secondary-subtle) 76%, white)
    );
    border: 1px solid color-mix(in srgb, var(--color-primary-border) 24%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, white 52%, transparent),
      0 0.25rem 0.75rem color-mix(in srgb, var(--color-primary-focus-ring) 14%, transparent);
    z-index: 0;
    pointer-events: none;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus-border);
    outline-offset: 2px;
  }

  .nav-link__icon {
    position: relative;
    z-index: 1;
    width: 1rem;
    height: 1rem;
  }

  .nav-link__label {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .nav-link,
    .nav-link__active {
      border-radius: var(--rounded-full);
    }
  }
</style>
