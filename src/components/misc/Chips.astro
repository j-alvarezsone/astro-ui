---
import { Icon, type IconProps } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ChipsPassThrough } from '@/types/theme/misc/chips';
import { splitPassThroughAttributes } from '@utils/theme/passThrough';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  icon?: IconProps;
  iconPos?: 'left' | 'right';
  removeIcon?: IconProps;
  image?: {
    src: string;
    alt: string;
  };
  pt?: ChipsPassThrough;
}

const { size = 'md', label, icon, iconPos = 'left', removeIcon, image, pt, ...rest } = Astro.props;

const imageSizes: Record<NonNullable<Props['size']>, number> = {
  sm: 26,
  md: 30,
  lg: 34,
} as const;

const imageDimension = imageSizes[size];

const { className: rootClass, attributes: rootAttributes } = splitPassThroughAttributes(pt?.root);
const { className: imageClass, attributes: imageAttributes } = splitPassThroughAttributes(pt?.image);
const { className: iconClass, attributes: iconAttributes } = splitPassThroughAttributes(pt?.icon);
const { className: labelClass, attributes: labelAttributes } = splitPassThroughAttributes(pt?.label);
const { className: removeIconClass, attributes: removeIconAttributes } = splitPassThroughAttributes(pt?.removeIcon);
---

<button
  type="button"
  class:list={['chips', `chips--${size}`, { 'chips--with-image': Boolean(image) }, rootClass]}
  {...rootAttributes}
  {...rest}
>
  {
    image && (
      <Image
        src={image.src}
        alt={image.alt}
        width={imageDimension}
        height={imageDimension}
        class:list={['chips__image', imageClass]}
        {...imageAttributes}
      />
    )
  }
  {
    icon && (!image || iconPos === 'right') && (
      <Icon {...icon} class:list={['chips__icon', `chips__icon--${iconPos}`, iconClass]} {...iconAttributes} />
    )
  }
  <span class:list={['chips__label', labelClass]} {...labelAttributes}>
    <slot>{label}</slot>
  </span>
  {
    removeIcon && iconPos !== 'right' && (
      <Icon {...removeIcon} class:list={['chips__remove-icon', removeIconClass]} {...removeIconAttributes} />
    )
  }
</button>

<style>
  .chips {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    border: 1px solid var(--chips-border-color);
    border-radius: var(--rounded-full);
    padding-block: var(--spacing-1);
    padding-inline: var(--spacing-2);
    background-color: var(--chips-background-color);
    color: var(--chips-color);
    cursor: pointer;
  }

  .chips[data-active] {
    background-color: var(--chips-active-background-color);
    border-color: var(--chips-active-border-color);
    color: var(--chips-active-color);
  }

  .chips--sm {
    padding-block: var(--spacing-0-5);
    padding-inline: var(--spacing-1);
    font-size: var(--font-size-sm);
  }

  .chips--lg {
    padding-block: var(--spacing-1-5);
    padding-inline: var(--spacing-3);
    font-size: var(--font-size-lg);
  }

  .chips--with-image.chips--sm {
    padding-inline: var(--spacing-0-5);
  }

  .chips--with-image.chips--md {
    padding-inline: var(--spacing-1);
  }

  .chips--with-image.chips--lg {
    padding-inline: var(--spacing-2);
  }

  .chips__icon--right {
    order: 1;
  }

  .chips__label {
    display: inline-flex;
    align-items: center;
  }

  .chips__remove-icon {
    flex-shrink: 0;
  }

  .chips__image {
    border-radius: var(--rounded-full);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    flex-shrink: 0;
  }

  .chips:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--color-focus-ring-overlay);
    border-color: var(--color-focus-ring);
  }
</style>
