---
import { Icon, type IconProps } from 'astro-icon/components';
import type { ClassValue } from '@/types/theme/form/shared';

export interface DropdownItem {
  label: string;
  href?: string;
  description?: string;
  icon?: IconProps;
  target?: string;
  rel?: string;
}

interface Props {
  id?: string;
  label?: string;
  placement?: 'bottom-start' | 'bottom-end' | 'top-start' | 'top-end' | 'right-start' | 'left-start';
  items?: DropdownItem[];
  class?: ClassValue;
  triggerClass?: ClassValue;
  panelClass?: ClassValue;
}

const {
  id,
  label = 'Menu',
  placement = 'bottom-start',
  items = [],
  class: className,
  triggerClass,
  panelClass,
} = Astro.props;

const baseId = id ?? `dropdown-${Math.random().toString(36).slice(2, 10)}`;
const panelId = `${baseId}-panel`;
const triggerId = `${baseId}-trigger`;
const hasCustomContent = Astro.slots.has('default');
---

<app-dropdown class:list={['dropdown', className]} data-placement-preference={placement}>
  <button
    id={triggerId}
    type="button"
    class:list={['dropdown__trigger', triggerClass]}
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls={panelId}
    data-dropdown-trigger
  >
    <slot name="trigger">{label}</slot>
    <Icon name="mdi:chevron-down" class="dropdown__trigger-icon" aria-hidden="true" />
  </button>

  <div id={panelId} class:list={['dropdown__panel', panelClass]} data-dropdown-panel hidden>
    {
      hasCustomContent ? (
        <slot />
      ) : (
        <ul class="dropdown__menu" role="menu" aria-labelledby={triggerId}>
          {items.map((item) => (
            <li role="none">
              {item.href ? (
                <a
                  href={item.href}
                  class="dropdown__item"
                  target={item.target}
                  rel={item.rel}
                  role="menuitem"
                  data-dropdown-item
                >
                  {item.icon && <Icon {...item.icon} class="dropdown__item-icon" aria-hidden="true" />}
                  <span class="dropdown__item-copy">
                    <span class="dropdown__item-label">{item.label}</span>
                    {item.description && <span class="dropdown__item-description">{item.description}</span>}
                  </span>
                </a>
              ) : (
                <button type="button" class="dropdown__item" data-dropdown-item role="menuitem" tabindex="0">
                  {item.icon && <Icon {...item.icon} class="dropdown__item-icon" aria-hidden="true" />}
                  <span class="dropdown__item-copy">
                    <span class="dropdown__item-label">{item.label}</span>
                    {item.description && <span class="dropdown__item-description">{item.description}</span>}
                  </span>
                </button>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</app-dropdown>

<script>
  import '@web-components/dropdown.web';
</script>

<style>
  .dropdown {
    display: block;
    width: 100%;
  }

  .dropdown__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: 2.75rem;
    padding: var(--spacing-2) var(--spacing-3);
    border: 1px solid transparent;
    border-radius: var(--rounded-lg);
    background-color: transparent;
    color: var(--color-fg-muted);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
    position: relative;
    isolation: isolate;
    width: 100%;
    justify-content: space-between;
  }

  .dropdown[data-open='true'] .dropdown__trigger,
  .dropdown__trigger:hover {
    background-color: color-mix(in srgb, var(--color-primary-subtle) 82%, white);
    border-color: color-mix(in srgb, var(--color-primary-border) 22%, transparent);
    box-shadow: 0 0.375rem 1rem color-mix(in srgb, var(--color-primary-focus-ring) 16%, transparent);
    color: var(--color-primary-fg);
    transform: translateY(-1px);
  }

  .dropdown__trigger:focus-visible {
    outline: 2px solid var(--color-focus-border);
    outline-offset: 2px;
  }

  .dropdown__trigger-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 180ms ease;
  }

  .dropdown[data-open='true'] .dropdown__trigger-icon {
    transform: rotate(180deg);
  }

  .dropdown__panel {
    position: static;
    inset: auto;
    z-index: 70;
    width: 100%;
    min-width: 0;
    max-width: none;
    margin-top: var(--spacing-2);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-lg);
    background: color-mix(in srgb, var(--color-surface) 96%, white);
    box-shadow: none;
    backdrop-filter: none;
    padding: var(--spacing-1);
  }

  .dropdown__menu {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  :global(.dropdown__item) {
    width: 100%;
    border: 0;
    border-radius: var(--rounded-md);
    background: transparent;
    text-align: left;
    padding: var(--spacing-2) var(--spacing-3);
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    cursor: pointer;
    min-height: auto;
  }

  :global(.dropdown__item:hover),
  :global(.dropdown__item:focus-visible) {
    background-color: color-mix(in srgb, var(--color-primary-subtle) 60%, transparent);
    outline: none;
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  :global(.dropdown__item-icon) {
    margin-top: var(--spacing-1);
    width: 1rem;
    height: 1rem;
    color: var(--color-primary-fg);
    flex-shrink: 0;
  }

  :global(.dropdown__item-copy) {
    display: grid;
    gap: var(--spacing-1);
  }

  :global(.dropdown__item-label) {
    font-weight: var(--font-weight-semibold);
    line-height: 1.1;
  }

  :global(.dropdown__item-description) {
    color: var(--color-fg-muted);
    font-size: var(--font-size-sm);
    line-height: 1.3;
  }

  @media (min-width: 1024px) {
    .dropdown {
      position: relative;
      display: inline-flex;
      width: auto;
    }

    .dropdown__trigger {
      width: auto;
      justify-content: flex-start;
      border-radius: var(--rounded-full);
      padding-inline: var(--spacing-4);
    }

    .dropdown__panel {
      position: fixed;
      inset: auto;
      width: auto;
      min-width: min(22rem, calc(100vw - (var(--spacing-4) * 2)));
      max-width: min(28rem, calc(100vw - (var(--spacing-4) * 2)));
      margin-top: 0;
      border-radius: var(--rounded-xl);
      box-shadow:
        0 16px 30px -22px rgba(15, 23, 42, 0.45),
        0 8px 20px -12px rgba(15, 23, 42, 0.35);
      backdrop-filter: blur(6px);
      padding: var(--spacing-2);
    }

    .dropdown__menu {
      gap: var(--spacing-1);
    }

    :global(.dropdown__item) {
      border-radius: var(--rounded-lg);
      padding: var(--spacing-3);
    }

    :global(.dropdown__item-description) {
      line-height: 1.35;
    }
  }
</style>
