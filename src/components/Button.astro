---
import type { Polymorphic } from 'astro/types';
import type { IconProps } from 'astro-icon/components';
import { Icon } from 'astro-icon/components';
import Loader from '@components/Loader.astro';
import type { ButtonPassThrough } from '@/types/theme/button';
import { deriveAriaLabelFromIconName } from '@utils/icon/deriveAriaLabelFromIconName';
import { mergePassThroughAttributes, splitPassThroughAttributes } from '@utils/theme/passThrough';

type Props<Tag extends 'button' | 'a'> = Polymorphic<{
  as: Tag;
  isLoading?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  label?: string;
  variant?: 'primary' | 'secondary' | 'contrast' | 'success' | 'warning' | 'danger';
  rounded?: boolean;
  size?: 'sm' | 'md' | 'lg';
  icon?: IconProps;
  iconPos?: 'left' | 'right';
  outline?: boolean;
  ripple?: boolean;
  pt?: ButtonPassThrough;
}>;

const {
  as: Tag = 'button',
  isLoading = false,
  disabled = false,
  type = 'button',
  label,
  variant = 'primary',
  rounded = false,
  size = 'md',
  icon,
  iconPos = 'left',
  outline = false,
  ripple = true,
  pt,
  class: className,
  ...rest
} = Astro.props as Props<'button' | 'a'>;

type AriaBusy = 'polite' | 'off' | 'assertive' | undefined;

const isButton = Tag === 'button';
const isLink = Tag === 'a';
const hasLabel = Boolean(label) || Boolean(Astro.slots.default);

const iconName = typeof icon?.name === 'string' ? icon.name : undefined;
const autoIconAriaLabel = icon && !hasLabel ? deriveAriaLabelFromIconName(iconName) : undefined;

const buttonClasses = [
  'button',
  `button--${variant}`,
  `button--${size}`,
  {
    'button--outline': outline,
    'button--rounded': rounded,
    'button--disabled': disabled || isLoading,
    'button--icon-only': icon && !hasLabel,
  },
];

const linkClasses = [
  'button',
  'button__link',
  `button__link--${size}`,
  {
    'button__link--disabled': disabled || isLoading,
  },
];

const rootPassThrough = mergePassThroughAttributes(
  {
    ...rest,
    ...(autoIconAriaLabel && { 'aria-label': autoIconAriaLabel }),

    ...(isButton && {
      type,
      disabled: disabled || isLoading,
      'aria-disabled': disabled || isLoading,
      'aria-busy': isLoading || undefined,
      'aria-live': (isLoading ? 'polite' : undefined) as AriaBusy,
    }),

    ...(isLink && {
      ...((disabled || isLoading) && {
        'aria-disabled': true,
        href: undefined,
      }),
    }),
  },
  pt?.root,
);

const { className: rootPassThroughClass, attributes: rootAttributes } = splitPassThroughAttributes(rootPassThrough);
const { className: iconPassThroughClass, attributes: iconPassThroughAttributes } = splitPassThroughAttributes(pt?.icon);
const { className: labelPassThroughClass, attributes: labelPassThroughAttributes } = splitPassThroughAttributes(
  pt?.label,
);
const { className: loaderPassThroughClass, attributes: loaderPassThroughAttributes } = splitPassThroughAttributes(
  pt?.loader,
);
---

<Tag class:list={[...(isButton ? buttonClasses : linkClasses), rootPassThroughClass, className]} {...rootAttributes}>
  {isButton && ripple && <ripple-effect />}
  {
    icon && isButton && (
      <Icon
        {...icon}
        class:list={['button__icon', { 'button__icon--right': iconPos === 'right' }, iconPassThroughClass]}
        {...iconPassThroughAttributes}
      />
    )
  }
  <span
    class:list={[
      'button__label',
      `button__label--${size}`,
      { 'button__label--loading': isLoading },
      labelPassThroughClass,
    ]}
    aria-hidden={isLoading || undefined}
    {...labelPassThroughAttributes}
  >
    <slot>{label}</slot>
  </span>
  {
    isLoading && (
      <>
        <span
          class:list={['button__loader', loaderPassThroughClass]}
          aria-hidden="true"
          {...loaderPassThroughAttributes}
        >
          <Loader size={size} color="neutral" isTextVisible={false} />
        </span>
        <span class="sr-only">Loading</span>
      </>
    )
  }
</Tag>

<script>
  import '@web-components/ripple.web';
</script>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--button-gap, var(--spacing-2));
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    border-radius: var(--button-border-radius, var(--rounded-lg));
    margin: var(--spacing-0);
    border: none;
  }

  .button--rounded {
    border-radius: var(--button-rounded-border-radius, var(--rounded-full));
  }
  /****
  Variants
  ****/
  .button--primary {
    --button-focus-ring-color: var(--button-primary-focus-ring-color, var(--color-primary-focus-ring));
    background-color: var(--button-primary-background-color, var(--color-primary-fill));
    color: var(--button-primary-color, var(--color-primary-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-primary-border-color, var(--color-primary-border));

    &:hover {
      background-color: var(--button-primary-hover-background-color, var(--color-primary-fill-hover));
    }
  }

  .button--primary.button--outline {
    background-color: transparent;
    color: var(--button-primary-outline-color, var(--color-primary-fg));
    border-color: var(--button-primary-outline-border-color, var(--color-primary-border));

    &:hover {
      background-color: var(--button-primary-outline-hover-background-color, var(--color-primary-subtle));
    }
  }

  .button--secondary {
    --button-focus-ring-color: var(--button-secondary-focus-ring-color, var(--color-secondary-focus-ring));
    background-color: var(--button-secondary-background-color, var(--color-secondary-fill));
    color: var(--button-secondary-color, var(--color-secondary-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-secondary-border-color, var(--color-secondary-border));

    &:hover {
      background-color: var(--button-secondary-hover-background-color, var(--color-secondary-fill-hover));
    }
  }

  .button--secondary.button--outline {
    background-color: transparent;
    color: var(--button-secondary-outline-color, var(--color-secondary-fg));
    border-color: var(--button-secondary-outline-border-color, var(--color-secondary-border));

    &:hover {
      background-color: var(--button-secondary-outline-hover-background-color, var(--color-secondary-subtle));
    }
  }

  .button--contrast.button--outline {
    background-color: transparent;
    color: var(--button-contrast-outline-color, var(--color-contrast-fg));
    border-color: var(--button-contrast-outline-border-color, var(--color-contrast-border));

    &:hover {
      background-color: var(--button-contrast-outline-hover-background-color, var(--color-contrast-subtle));
    }
  }

  .button--contrast {
    --button-focus-ring-color: var(--button-contrast-focus-ring-color, var(--color-contrast-focus-ring));
    background-color: var(--button-contrast-background-color, var(--color-contrast-fill));
    color: var(--button-contrast-color, var(--color-contrast-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-contrast-border-color, var(--color-contrast-border));

    &:hover {
      background-color: var(--button-contrast-hover-background-color, var(--color-contrast-fill-hover));
    }
  }

  .button--success.button--outline {
    background-color: transparent;
    color: var(--button-success-outline-color, var(--color-success-fg));
    border-color: var(--button-success-outline-border-color, var(--color-success-border));

    &:hover {
      background-color: var(--button-success-outline-hover-background-color, var(--color-success-subtle));
    }
  }

  .button--success {
    --button-focus-ring-color: var(--button-success-focus-ring-color, var(--color-success-focus-ring));
    background-color: var(--button-success-background-color, var(--color-success-fill));
    color: var(--button-success-color, var(--color-success-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-success-border-color, var(--color-success-border));

    &:hover {
      background-color: var(--button-success-hover-background-color, var(--color-success-fill-hover));
    }
  }

  .button--warning.button--outline {
    background-color: transparent;
    color: var(--button-warning-outline-color, var(--color-warning-fg));
    border-color: var(--button-warning-outline-border-color, var(--color-warning-border));

    &:hover {
      background-color: var(--button-warning-outline-hover-background-color, var(--color-warning-subtle));
    }
  }

  .button--warning {
    --button-focus-ring-color: var(--button-warning-focus-ring-color, var(--color-warning-focus-ring));
    background-color: var(--button-warning-background-color, var(--color-warning-fill));
    color: var(--button-warning-color, var(--color-warning-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-warning-border-color, var(--color-warning-border));

    &:hover {
      background-color: var(--button-warning-hover-background-color, var(--color-warning-fill-hover));
    }
  }

  .button--danger.button--outline {
    background-color: transparent;
    color: var(--button-danger-outline-color, var(--color-danger-fg));
    border-color: var(--button-danger-outline-border-color, var(--color-danger-border));

    &:hover {
      background-color: var(--button-danger-outline-hover-background-color, var(--color-danger-subtle));
    }
  }

  .button--danger {
    --button-focus-ring-color: var(--button-danger-focus-ring-color, var(--color-danger-focus-ring));
    background-color: var(--button-danger-background-color, var(--color-danger-fill));
    color: var(--button-danger-color, var(--color-danger-on-fill));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-danger-border-color, var(--color-danger-border));

    &:hover {
      background-color: var(--button-danger-hover-background-color, var(--color-danger-fill-hover));
    }
  }
  /****
  Sizes
  ****/
  .button--sm,
  .button__link--sm {
    padding-block: var(--button-sm-padding-block, var(--spacing-1-5));
    padding-inline: var(--button-sm-padding-inline, var(--spacing-2-5));
  }

  .button--md,
  .button__link--md {
    padding-block: var(--button-md-padding-block, var(--spacing-2));
    padding-inline: var(--button-md-padding-inline, var(--spacing-3));
  }

  .button--lg,
  .button__link--lg {
    padding-block: var(--button-lg-padding-block, var(--spacing-2-5));
    padding-inline: var(--button-lg-padding-inline, var(--spacing-3-5));
  }

  .button__label--loading {
    opacity: var(--button-label-loading-opacity, 0);
  }

  .button__loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--button-loader-color, currentColor);
  }

  .button__label--sm {
    font-size: var(--button-label-sm-font-size, var(--font-size-sm));
  }

  .button__label--md {
    font-size: var(--button-label-md-font-size, var(--font-size-base));
  }

  .button__label--lg {
    font-size: var(--button-label-lg-font-size, var(--font-size-lg));
  }

  /****
  Link
  ****/
  .button--link {
    text-decoration: none;
    color: var(--color-link-fg);

    &:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  /****
  Disabled State
  ****/
  .button.button--disabled {
    background-color: var(--button-disabled-background-color, var(--color-disabled-fill));
    color: var(--button-disabled-color, var(--color-fg-disabled));
    border: var(--button-border-width, var(--spacing-0-25)) solid
      var(--button-disabled-border-color, var(--color-disabled-border));
    pointer-events: none;
  }

  .button__link--disabled {
    color: var(--button-link-disabled-color, var(--color-fg-disabled));
    opacity: var(--button-link-disabled-opacity, 0.8);
    pointer-events: none;
  }

  /****
  Focus State
  ****/
  .button:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 var(--button-focus-ring-width, var(--spacing-0-5)) var(--button-focus-ring-color, var(--color-focus-ring)),
      0 0 0 var(--spacing-1)
        color-mix(in srgb, var(--button-focus-ring-color, var(--color-focus-ring)) 28%, transparent);
    z-index: 1;
  }

  /****
  Icon
  ****/

  .button__icon--right {
    order: 1;
  }

  .button__icon {
    color: var(--button-icon-color, currentColor);
  }

  .button--icon-only {
    gap: var(--spacing-0);
  }

  /****
  Runtime loading state (set via data-loading attribute by web components)
  ****/
  .button[data-loading] .button__label {
    opacity: var(--button-label-loading-opacity, 0);
  }

  .button[data-loading] {
    cursor: not-allowed;
  }

  .button[data-loading]::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--color-border-strong);
    border-top-color: transparent;
    border-radius: 9999px;
    animation: button-spinner-spin 0.75s linear infinite;
  }

  @keyframes button-spinner-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button[data-loading]::after {
      animation: none;
    }
  }
</style>
