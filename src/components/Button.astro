---
import type { Polymorphic } from 'astro/types';
import type { IconProps } from 'astro-icon/components';
import { Icon } from 'astro-icon/components';
import Loader from '@components/Loader.astro';
import { deriveAriaLabelFromIconName } from '@utils/icon/deriveAriaLabelFromIconName';

type Props<Tag extends 'button' | 'a'> = Polymorphic<{
  as: Tag;
  isLoading?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  label?: string;
  variant?: 'primary' | 'secondary' | 'contrast' | 'success' | 'warning' | 'danger';
  rounded?: boolean;
  size?: 'sm' | 'md' | 'lg';
  icon?: IconProps;
  iconPos?: 'left' | 'right';
  ripple?: boolean;
}>;

const {
  as: Tag = 'button',
  isLoading = false,
  disabled = false,
  type = 'button',
  label,
  variant = 'primary',
  rounded = false,
  size = 'md',
  icon,
  iconPos = 'left',
  ripple = true,
  class: className,
  ...rest
} = Astro.props as Props<'button' | 'a'>;

type AriaBusy = 'polite' | 'off' | 'assertive' | undefined;

const isButton = Tag === 'button';
const isLink = Tag === 'a';
const hasLabel = Boolean(label) || Boolean(Astro.slots.default);

const iconName = typeof icon?.name === 'string' ? icon.name : undefined;
const autoIconAriaLabel = icon && !hasLabel ? deriveAriaLabelFromIconName(iconName) : undefined;

const buttonClasses = [
  'button',
  `button--${variant}`,
  `button--${size}`,
  {
    'button--rounded': rounded,
    'button--disabled': disabled || isLoading,
    'button--icon-only': icon && !hasLabel,
  },
];

const linkClasses = [
  'button',
  'button__link',
  `button__link--${size}`,
  {
    'button__link--disabled': disabled || isLoading,
  },
];

const computedProps = {
  ...rest,
  class: className,
  ...(autoIconAriaLabel && { 'aria-label': autoIconAriaLabel }),

  ...(isButton && {
    type,
    disabled: disabled || isLoading,
    'aria-disabled': disabled || isLoading,
    'aria-busy': isLoading || undefined,
    'aria-live': (isLoading ? 'polite' : undefined) as AriaBusy,
  }),

  ...(isLink && {
    ...((disabled || isLoading) && {
      'aria-disabled': true,
      href: undefined,
    }),
  }),
};
---

<Tag class:list={isButton ? buttonClasses : linkClasses} {...computedProps}>
  {isButton && ripple && <ripple-effect />}
  {icon && isButton && <Icon {...icon} class:list={['button__icon', { 'button__icon--right': iconPos === 'right' }]} />}
  <span
    class:list={['button__label', `button__label--${size}`, { 'button__label--loading': isLoading }]}
    aria-hidden={isLoading || undefined}
  >
    <slot>{label}</slot>
  </span>
  {
    isLoading && (
      <>
        <span class="button__loader" aria-hidden="true">
          <Loader size={size} color="neutral" isTextVisible={false} />
        </span>
        <span class="sr-only">Loading</span>
      </>
    )
  }
</Tag>

<script>
  import '@web-components/ripple.web';
</script>

<style>
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    border-radius: var(--rounded-lg);
    margin: var(--spacing-0);
    border: none;
  }

  .button--rounded {
    border-radius: var(--rounded-full);
  }
  /****
  Variants
  ****/
  .button--primary {
    background-color: var(--color-primary-fill);
    color: var(--color-primary-on-fill);
    border: 1px solid var(--color-primary-border);

    &:hover {
      background-color: var(--color-primary-fill-hover);
    }
  }

  .button--secondary {
    background-color: var(--color-secondary-fill);
    color: var(--color-secondary-on-fill);
    border: 1px solid var(--color-secondary-border);

    &:hover {
      background-color: var(--color-secondary-fill-hover);
    }
  }

  .button--contrast {
    background-color: var(--color-contrast-fill);
    color: var(--color-contrast-on-fill);
    border: 1px solid var(--color-contrast-border);

    &:hover {
      background-color: var(--color-contrast-fill-hover);
    }
  }

  .button--success {
    background-color: var(--color-success-fill);
    color: var(--color-success-on-fill);
    border: 1px solid var(--color-success-border);

    &:hover {
      background-color: var(--color-success-fill-hover);
    }
  }

  .button--warning {
    background-color: var(--color-warning-fill);
    color: var(--color-warning-on-fill);
    border: 1px solid var(--color-warning-border);

    &:hover {
      background-color: var(--color-warning-fill-hover);
    }
  }

  .button--danger {
    background-color: var(--color-danger-fill);
    color: var(--color-danger-on-fill);
    border: 1px solid var(--color-danger-border);

    &:hover {
      background-color: var(--color-danger-fill-hover);
    }
  }
  /****
  Sizes
  ****/
  .button--sm,
  .button__link--sm {
    padding-block: var(--spacing-1-5);
    padding-inline: var(--spacing-2-5);
  }

  .button--md,
  .button__link--md {
    padding-block: var(--spacing-2);
    padding-inline: var(--spacing-3);
  }

  .button--lg,
  .button__link--lg {
    padding-block: var(--spacing-2-5);
    padding-inline: var(--spacing-3-5);
  }

  .button__label--loading {
    opacity: 0;
  }

  .button__loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .button__label--sm {
    font-size: var(--font-size-sm);
  }

  .button__label--md {
    font-size: var(--font-size-base);
  }

  .button__label--lg {
    font-size: var(--font-size-lg);
  }

  /****
  Link
  ****/
  .button--link {
    text-decoration: none;
    color: var(--color-link-fg);

    &:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  /****
  Disabled State
  ****/
  .button.button--disabled {
    background-color: var(--color-disabled-fill);
    color: var(--color-fg-disabled);
    border: 1px solid var(--color-disabled-border);
    pointer-events: none;
  }

  .button__link--disabled {
    color: var(--color-fg-disabled);
    opacity: 0.8;
    pointer-events: none;
  }

  /****
  Focus State
  ****/
  .button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    z-index: 1;
  }

  /****
  Icon
  ****/

  .button__icon--right {
    order: 1;
  }

  .button--icon-only {
    gap: var(--spacing-0);
  }
</style>
