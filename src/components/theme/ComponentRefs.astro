---
import Chips from '@components/misc/Chips.astro';
import InputText from '@components/form/InputText.astro';
import { Icon } from 'astro-icon/components';

import type { ComponentRef } from '@constants/theme-component-refs';

interface Props {
  refs: ComponentRef[];
}

const { refs } = Astro.props;
const categories = [...new Set(refs.map((r) => r.category))];
---

<comp-refs-filter class="comp-refs">
  <div class="comp-refs__toolbar">
    <div class="comp-refs__toolbar-top">
      <p class="comp-refs__heading">Component References</p>
      <span class="comp-refs__count" aria-live="polite" data-count>
        {refs.length} component{refs.length === 1 ? '' : 's'}
      </span>
    </div>
    <div class="comp-refs__toolbar-bottom">
      <div class="comp-refs__filter-wrap">
        <InputText
          name="comp-refs-filter"
          label="Filter components"
          placeholder="Filter components…"
          icon={{ name: 'mdi:magnify' }}
          iconPos="left"
          sizes="sm"
          labelPosition="on"
          class="comp-refs__filter-input"
          pt={{ label: { class: 'comp-refs__filter-label' } }}
          autocomplete="off"
          spellcheck="false"
          data-filter
        />
      </div>
      <div class="comp-refs__cats" role="group" aria-label="Filter by category">
        <Chips size="sm" data-category="" data-active label="All" />
        {categories.map((cat) => <Chips size="sm" data-category={cat} label={cat} />)}
      </div>
    </div>
  </div>

  <div class="comp-refs__list" aria-label="Component reference list">
    {
      categories.map((cat) => (
        <div class="comp-refs__group" data-group>
          <p class="comp-refs__group-label">{cat}</p>
          <ul class="comp-refs__rows">
            {refs
              .filter((r) => r.category === cat)
              .map((ref) => (
                <li class="comp-refs__row" data-row data-label={ref.label.toLowerCase()} data-row-cat={ref.category}>
                  <a href={ref.href} class="comp-refs__link">
                    <span class="comp-refs__name">{ref.label}</span>
                    <span class="comp-refs__desc">{ref.description}</span>
                    <Icon name="mdi:arrow-right" class="comp-refs__arrow" aria-hidden="true" width="18" height="18" />
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
    <p class="comp-refs__empty" hidden data-empty>No components match your search.</p>
  </div>
</comp-refs-filter>

<script>
  import '@web-components/comp-refs-filter.web.ts';
</script>

<style>
  .comp-refs {
    border: 1px solid color-mix(in oklab, var(--color-border) 80%, transparent);
    border-radius: var(--rounded-xl, 12px);
    overflow: hidden;
    background: var(--color-surface);
  }

  .comp-refs__toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-5);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
    background: color-mix(in oklab, var(--color-surface) 85%, #f9fafb 15%);
  }

  .comp-refs__toolbar-top {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-3);
  }

  .comp-refs__toolbar-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-2);
  }

  .comp-refs__heading {
    font-size: var(--font-size-xl, 1.25rem);
    font-weight: 700;
    margin: 0;
  }

  .comp-refs__count {
    font-size: var(--font-size-xs, 0.75rem);
    font-variant-numeric: tabular-nums;
    padding: 2px var(--spacing-2);
    border-radius: var(--rounded-full);
    background: var(--color-primary-subtle);
    color: var(--color-primary-on-subtle);
    font-weight: 600;
    white-space: nowrap;
  }

  .comp-refs__filter-wrap {
    width: 100%;
  }

  .comp-refs__cats {
    display: flex;
    gap: var(--spacing-1);
    flex-wrap: wrap;
  }

  .comp-refs__list {
    padding: var(--spacing-2) 0;
  }

  .comp-refs__group[hidden] {
    display: none;
  }

  .comp-refs__group {
    padding-bottom: var(--spacing-1);
  }

  .comp-refs__group-label {
    padding: var(--spacing-2) var(--spacing-5) var(--spacing-1);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    opacity: 0.7;
    margin: 0;
  }

  .comp-refs__rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comp-refs__row[hidden] {
    display: none;
  }

  .comp-refs__link {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-2-5, 10px) var(--spacing-5);
    text-decoration: none;
    color: inherit;
    transition: background 0.1s ease;
  }

  .comp-refs__link:hover {
    background: var(--color-primary-subtle);
  }

  .comp-refs__link:hover .comp-refs__arrow {
    transform: translateX(2px);
    color: var(--color-primary-fg);
  }

  .comp-refs__name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-fg);
    white-space: nowrap;
  }

  .comp-refs__desc {
    font-size: var(--font-size-sm);
    color: var(--color-fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .comp-refs__arrow {
    color: var(--color-fg-muted);
    flex-shrink: 0;
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .comp-refs__empty {
    padding: var(--spacing-6) var(--spacing-5);
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--color-fg-muted);
    margin: 0;
  }
</style>
