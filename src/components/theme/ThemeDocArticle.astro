---

---

<article class="theme-doc-article">
  <div class="theme-doc-content">
    <slot />
  </div>
</article>

<style>
  .theme-doc-article {
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-2xl);
    background-color: color-mix(in oklab, var(--color-surface) 85%, var(--color-contrast-subtle) 15%);
    box-shadow: 0 14px 34px color-mix(in oklab, var(--color-contrast-fill) 8%, transparent);
    overflow: clip;
  }

  .theme-doc-content {
    padding: var(--spacing-5);
    color: color-mix(in oklab, var(--color-fg) 88%, var(--color-fg-muted) 12%);
    max-width: 72ch;
  }

  .theme-doc-content :global(h2),
  .theme-doc-content :global(h3),
  .theme-doc-content :global(h4) {
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-2);
  }

  .theme-doc-content :global(p),
  .theme-doc-content :global(ol),
  .theme-doc-content :global(ul) {
    margin-top: 0;
    margin-bottom: var(--spacing-3);
  }

  .theme-doc-content :global(ol),
  .theme-doc-content :global(ul) {
    padding-left: var(--spacing-5);
  }

  .theme-doc-content :global(li + li) {
    margin-top: var(--spacing-1);
  }

  .theme-doc-content :global(code) {
    font-size: 0.9em;
    padding: var(--spacing-1) var(--spacing-1-5);
    border-radius: var(--rounded-md);
    background-color: color-mix(in oklab, var(--color-primary-subtle) 46%, var(--color-surface) 54%);
  }

  .theme-doc-content :global(pre) {
    margin-top: 0;
    margin-bottom: var(--spacing-4);
    border: 1px solid color-mix(in oklab, var(--color-border) 85%, var(--color-border-strong) 15%);
    border-radius: var(--rounded-lg);
    background-color: color-mix(in oklab, var(--color-contrast-fill) 92%, var(--color-fg) 8%);
    box-shadow: 0 16px 34px color-mix(in oklab, var(--color-contrast-fill) 18%, transparent);
  }

  .theme-doc-content :global(pre code) {
    padding: 0;
    border-radius: 0;
    background: transparent;
  }

  .theme-doc-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--spacing-4);
    font-size: var(--font-size-sm);
  }

  .theme-doc-content :global(thead) {
    background-color: color-mix(in oklab, var(--color-contrast-subtle) 60%, var(--color-surface) 40%);
    border-bottom: 2px solid var(--color-border);
  }

  .theme-doc-content :global(th) {
    padding: var(--spacing-2) var(--spacing-4);
    text-align: left;
    font-weight: var(--font-weight-semibold);
    color: var(--color-fg);
    white-space: nowrap;
  }

  .theme-doc-content :global(td) {
    padding: var(--spacing-2) var(--spacing-4);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent 40%);
    color: color-mix(in oklab, var(--color-fg) 85%, var(--color-fg-muted) 15%);
    vertical-align: top;
  }

  .theme-doc-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .theme-doc-content :global(tbody tr:hover td) {
    background-color: color-mix(in oklab, var(--color-primary-subtle) 30%, transparent 70%);
  }
</style>
