---
import type { IconProps } from 'astro-icon/components';
import InputField from './InputField.astro';

interface Props {
  name: string;
  placeholder: string;
  label: string;
  required?: boolean;
  icon?: IconProps;
  sizes?: 'sm' | 'md' | 'lg';
  errorText?: string;
  helpText?: string;
  labelPosition?: 'default' | 'over' | 'in' | 'on';
  disabled?: boolean;
  minLength?: number;
  maxLength?: number;
  min?: number;
  max?: number;
  pattern?: string;
  autocomplete?: 'on' | 'off';
  value?: string;
}

const {
  name,
  placeholder,
  label,
  required = false,
  icon,
  sizes = 'md',
  errorText,
  helpText,
  labelPosition = 'default',
  disabled = false,
  minLength,
  maxLength,
  min,
  max,
  pattern,
  autocomplete = 'off',
  value,
  ...rest
} = Astro.props;

const errorTextId = errorText ? `${name}-error` : undefined;
const helpTextId = helpText ? `${name}-help` : undefined;
const describedBy = [errorTextId, helpTextId].filter(Boolean).join(' ') || undefined;
---

<InputField
  name={name}
  label={label}
  labelPosition={labelPosition}
  sizes={sizes}
  icon={{ name: 'mdi:email-outline' }}
  iconPos="right"
  errorText={errorText}
  helpText={helpText}
  {...rest}
>
  <input
    id={name}
    name={name}
    type="email"
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    minlength={minLength}
    maxlength={maxLength}
    min={min}
    max={max}
    pattern={pattern}
    autocomplete={autocomplete}
    value={value}
    aria-describedby={describedBy}
    aria-invalid={errorText ? 'true' : undefined}
  />
</InputField>
