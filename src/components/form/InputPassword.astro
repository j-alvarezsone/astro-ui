---
import { Icon, type IconProps } from 'astro-icon/components';
import InputField from './InputField.astro';
import PasswordStrength, { type PasswordStrengthRule } from './PasswordStrength.astro';

interface Props {
  name: string;
  placeholder: string;
  label: string;
  required?: boolean;
  icon?: IconProps;
  sizes?: 'sm' | 'md' | 'lg';
  errorText?: string;
  helpText?: string;
  labelPosition?: 'default' | 'over' | 'in' | 'on';
  disabled?: boolean;
  minLength?: number;
  maxLength?: number;
  min?: number;
  max?: number;
  pattern?: string;
  autocomplete?: 'on' | 'off';
  value?: string;
  autofocus?: boolean;
  form?: string;
  readonly?: boolean;
  promptLabel?: string;
  promptSubLabel?: string;
  weakLabel?: string;
  mediumLabel?: string;
  strongLabel?: string;
  showStrengthHints?: boolean;
  strengthRules?: PasswordStrengthRule[];
}

const {
  name,
  placeholder,
  label,
  required = false,
  icon,
  sizes = 'md',
  errorText,
  helpText,
  labelPosition = 'default',
  disabled = false,
  minLength,
  maxLength,
  min,
  max,
  pattern,
  autocomplete = 'off',
  value,
  readonly = false,
  autofocus = false,
  form,
  promptLabel = 'Enter a password',
  promptSubLabel = '',
  weakLabel = 'Weak',
  mediumLabel = 'Medium',
  strongLabel = 'Strong',
  showStrengthHints = true,
  strengthRules,
  ...rest
} = Astro.props;

const errorTextId = errorText ? `${name}-error` : undefined;
const helpTextId = helpText ? `${name}-help` : undefined;
const strengthPanelId = `${name}-password-strength`;
const strengthStatusId = `${name}-password-strength-status`;
const strengthHintsId = showStrengthHints ? `${name}-password-strength-hints` : undefined;
const describedBy = [errorTextId, helpTextId, strengthStatusId, strengthHintsId].filter(Boolean).join(' ') || undefined;
---

<input-password>
  <Icon name="mdi:eye-off-outline" style="display: none;" aria-hidden="true" />
  <InputField
    name={name}
    label={label}
    labelPosition={labelPosition}
    sizes={sizes}
    icon={{ name: 'mdi:eye-outline', class: 'input-password-icon' }}
    iconPos="right"
    errorText={errorText}
    helpText={helpText}
    {...rest}
  >
    <input
      id={name}
      class="input-password"
      name={name}
      type="password"
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      minlength={minLength}
      maxlength={maxLength}
      min={min}
      max={max}
      pattern={pattern}
      autocomplete={autocomplete}
      value={value}
      autofocus={autofocus}
      form={form}
      readonly={readonly}
      aria-describedby={describedBy}
      aria-invalid={errorText ? 'true' : undefined}
    />
  </InputField>
  <PasswordStrength
    inputId={name}
    panelId={strengthPanelId}
    statusId={strengthStatusId}
    hintsId={strengthHintsId}
    promptLabel={promptLabel}
    promptSubLabel={promptSubLabel}
    weakLabel={weakLabel}
    mediumLabel={mediumLabel}
    strongLabel={strongLabel}
    showHints={showStrengthHints}
    rules={strengthRules}
  />
</input-password>

<style>
  input-password {
    display: block;
    position: relative;
  }
</style>

<script>
  import '@web-components/input-password.web';
</script>
