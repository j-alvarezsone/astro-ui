---
import { Icon, type IconProps } from 'astro-icon/components';
import InputField from './InputField.astro';

interface Props {
  name: string;
  placeholder: string;
  label: string;
  required?: boolean;
  icon?: IconProps;
  sizes?: 'sm' | 'md' | 'lg';
  errorText?: string;
  helpText?: string;
  labelPosition?: 'default' | 'over' | 'in' | 'on';
  disabled?: boolean;
  minLength?: number;
  maxLength?: number;
  min?: number;
  max?: number;
  pattern?: string;
  autocomplete?: 'on' | 'off';
  value?: string;
  autofocus?: boolean;
  form?: string;
  readonly?: boolean;
}

const {
  name,
  placeholder,
  label,
  required = false,
  icon,
  sizes = 'md',
  errorText,
  helpText,
  labelPosition = 'default',
  disabled = false,
  minLength,
  maxLength,
  min,
  max,
  pattern,
  autocomplete = 'off',
  value,
  readonly = false,
  autofocus = false,
  form,
  ...rest
} = Astro.props;

const errorTextId = errorText ? `${name}-error` : undefined;
const helpTextId = helpText ? `${name}-help` : undefined;
const describedBy = [errorTextId, helpTextId].filter(Boolean).join(' ') || undefined;
---

<input-password>
  <Icon name="mdi:eye-off-outline" style="display: none;" aria-hidden="true" />
  <InputField
    name={name}
    label={label}
    labelPosition={labelPosition}
    sizes={sizes}
    icon={{ name: 'mdi:eye-outline', class: 'input-password-icon' }}
    iconPos="right"
    errorText={errorText}
    helpText={helpText}
    {...rest}
  >
    <input
      id={name}
      class="input-password"
      name={name}
      type="password"
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      minlength={minLength}
      maxlength={maxLength}
      min={min}
      max={max}
      pattern={pattern}
      autocomplete={autocomplete}
      value={value}
      autofocus={autofocus}
      form={form}
      readonly={readonly}
      aria-describedby={describedBy}
      aria-invalid={errorText ? 'true' : undefined}
    />
  </InputField>
</input-password>

<script>
  import '@web-components/input-password.web';
</script>
