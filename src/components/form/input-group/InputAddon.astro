---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['input-addon', className]}>
  <slot />
</span>

<style>
  .input-addon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--spacing-3-5);
    background-color: var(--color-contrast-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-lg);
    color: var(--color-fg-muted);
    font-size: var(--font-size-sm);
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1;
  }
</style>
