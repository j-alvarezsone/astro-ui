---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['input-group', className]}>
  <slot />
</div>

<style>
  /* ── Container ───────────────────────────────────────────── */
  .input-group {
    position: relative; /* anchor for the out-of-flow label */
    display: flex;
    align-items: stretch;
    width: 100%;
    /*
     * Reserve block space for the absolutely-positioned label so it
     * doesn't overlap content above. The label height =
     *   font-size-sm (1 lh) × 1.2 line-height + the gap below it.
     */
    padding-block-start: calc(var(--font-size-sm) * 1.2 + var(--spacing-1-5));
  }

  /* Collapse the shared border between adjacent elements */
  .input-group > :global(* + *) {
    margin-inline-start: -1px;
  }

  /* ── Strip all corner radii from child elements ──────────── */
  .input-group > :global(.input-addon) {
    border-radius: 0;
  }

  /* InputText/InputField renders a .input-field > .input-field__wrapper */
  .input-group :global(.input-field__wrapper) {
    border-radius: 0;
  }

  /* ── Restore left radii for the first child ─────────────── */
  .input-group > :global(.input-addon:first-child) {
    border-start-start-radius: var(--rounded-lg);
    border-end-start-radius: var(--rounded-lg);
  }

  .input-group > :global(.input-field:first-child .input-field__wrapper) {
    border-start-start-radius: var(--rounded-lg);
    border-end-start-radius: var(--rounded-lg);
  }

  /* ── Restore right radii for the last child ─────────────── */
  .input-group > :global(.input-addon:last-child) {
    border-start-end-radius: var(--rounded-lg);
    border-end-end-radius: var(--rounded-lg);
  }

  .input-group > :global(.input-field:last-child .input-field__wrapper) {
    border-start-end-radius: var(--rounded-lg);
    border-end-end-radius: var(--rounded-lg);
  }

  /* ── Input field: pull default label out of the flex flow
   * so .input-field's height = wrapper height only, letting
   * the addon auto-stretch to match via align-items: stretch.
   ─────────────────────────────────────────────────────────────
   * NO position:relative on .input-field so the label anchors
   * to .input-group (position:relative above) instead — that
   * makes it span the full group width including the addon.
   * Flex items support z-index without position, so focus
   * ring stacking still works fine.
  ─────────────────────────────────────────────────────────── */
  .input-group > :global(.input-field) {
    flex: 1;
    min-width: 0;
  }

  /* Default label: sits inside the top padding area of the group */
  .input-group > :global(.input-field > .input-label) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    white-space: nowrap;
  }

  /* ── Focus: bring the input above addons so the ring is
        fully visible and not clipped by the adjacent border ── */
  .input-group > :global(.input-field:focus-within) {
    z-index: 1;
  }
</style>
