---
import type { InputTextPassThrough } from '@/types/theme/form/inputText';
import type { ClassValue } from '@/types/theme/form/shared';
import { Icon, type IconProps } from 'astro-icon/components';
import { mergePassThroughAttributes, splitPassThroughAttributes } from '@utils/theme/passThrough';
import InputLabel from './InputLabel.astro';

interface Props {
  name: string;
  label: string;
  labelPosition?: 'default' | 'over' | 'in' | 'on';
  sizes?: 'sm' | 'md' | 'lg';
  icon?: IconProps;
  iconPos?: 'left' | 'right';
  errorText?: string;
  helpText?: string;
  class?: ClassValue;
  pt?: InputTextPassThrough;
}

const {
  name,
  label,
  labelPosition = 'default',
  sizes = 'md',
  icon,
  iconPos = 'right',
  errorText,
  helpText,
  class: className,
  pt,
  ...rest
} = Astro.props;

const isFloating = labelPosition !== 'default';
const errorTextId = errorText ? `${name}-error` : undefined;
const helpTextId = helpText ? `${name}-help` : undefined;

// Offset floating label past a left icon (icon ≈ 1.25rem + gap).
const labelStart =
  isFloating && icon && iconPos !== 'right' ? 'calc(var(--spacing-3-5) + 1.25rem + var(--spacing-2))' : undefined;

const rootAttributes = mergePassThroughAttributes(rest, pt?.root);
const wrapperAttributes = mergePassThroughAttributes(
  labelStart ? { style: `--label-start: ${labelStart}` } : undefined,
  pt?.wrapper,
);
const inputLabelAttributes = pt?.label;
const iconAttributes = pt?.icon;
const helpTextAttributes = pt?.helpText;
const errorTextAttributes = pt?.errorText;

const { className: rootPassThroughClass, attributes: rootPassThroughAttributes } =
  splitPassThroughAttributes(rootAttributes);
const { className: wrapperPassThroughClass, attributes: wrapperPassThroughAttributes } =
  splitPassThroughAttributes(wrapperAttributes);
const { className: iconPassThroughClass, attributes: iconPassThroughAttributes } =
  splitPassThroughAttributes(iconAttributes);
const { className: helpTextPassThroughClass, attributes: helpTextPassThroughAttributes } =
  splitPassThroughAttributes(helpTextAttributes);
const { className: errorTextPassThroughClass, attributes: errorTextPassThroughAttributes } =
  splitPassThroughAttributes(errorTextAttributes);
---

<div class:list={['input-field', className, rootPassThroughClass]} {...rootPassThroughAttributes}>
  {!isFloating && <InputLabel for={name} label={label} position="default" {...inputLabelAttributes} />}
  <div
    class:list={[
      'input-field__wrapper',
      errorText && 'input-field__wrapper--error',
      isFloating && `input-field__wrapper--${labelPosition}`,
      `input-field__wrapper--${sizes}`,
      wrapperPassThroughClass,
    ]}
    {...wrapperPassThroughAttributes}
  >
    {isFloating && <InputLabel for={name} label={label} position={labelPosition} {...inputLabelAttributes} />}
    {
      icon && (
        <div
          class:list={['input-field__icon', `input-field__icon--${iconPos}`, iconPassThroughClass]}
          aria-hidden="true"
          {...iconPassThroughAttributes}
        >
          <Icon {...icon} />
        </div>
      )
    }
    <slot />
  </div>
  {
    errorText && (
      <p
        id={errorTextId}
        class:list={['input-field__error', errorTextPassThroughClass]}
        aria-live="polite"
        {...errorTextPassThroughAttributes}
      >
        {errorText}
      </p>
    )
  }
  {
    helpText && (
      <p
        id={helpTextId}
        class:list={['input-field__help', helpTextPassThroughClass]}
        {...helpTextPassThroughAttributes}
      >
        {helpText}
      </p>
    )
  }
</div>

<style>
  /* ── Layout ─────────────────────────────────────────────── */
  .input-field {
    display: flex;
    flex-direction: column;
    gap: var(--input-field-root-gap, var(--spacing-1-5));
  }

  .input-field__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--input-field-wrapper-gap, var(--spacing-2));
    width: 100%;
    border: 1px solid var(--input-field-wrapper-border-color, var(--color-border));
    border-radius: var(--input-field-wrapper-border-radius, var(--rounded-lg));
    background-color: var(--input-field-wrapper-background, var(--color-surface));
    padding-inline: var(--input-field-wrapper-padding-inline, var(--spacing-3-5));
  }

  .input-field__wrapper:hover:not(:focus-within):not(:has(:disabled)) {
    border-color: var(--input-field-wrapper-hover-border-color, var(--color-hover-border));
  }

  .input-field__wrapper:focus-within {
    border-color: var(--input-field-wrapper-focus-border-color, var(--color-focus-border));
    outline: 2px solid var(--input-field-wrapper-focus-ring-color, var(--color-focus-ring));
    outline-offset: 2px;
  }

  /* Explicit error state from props: always keep danger border. */
  .input-field__wrapper--error,
  .input-field__wrapper--error:hover,
  .input-field__wrapper--error:focus-within {
    border-color: var(--input-field-wrapper-error-border-color, var(--color-danger-border));
  }

  /* Validation states
   * - Invalid border only after user interaction,
   *   and only once the field has a value.
   * - Valid border only after user interaction, while focused,
   *   and only once the field has a value.
  */
  :global(form:not([novalidate]) .input-field__wrapper:has(input:user-invalid:not(:placeholder-shown))) {
    border-color: var(--input-field-wrapper-error-border-color, var(--color-danger-border));
  }

  :global(form:not([novalidate]) .input-field__wrapper:has(input:user-valid:focus:not(:placeholder-shown))) {
    border-color: var(--color-success-border);
  }

  .input-field__wrapper:has(:disabled) {
    background-color: var(--input-field-wrapper-disabled-background, var(--color-disabled-fill));
    cursor: not-allowed;
  }

  .input-field__wrapper:has(:disabled) .input-field__icon {
    opacity: var(--input-field-icon-disabled-opacity, 0.4);
  }

  /* ── Icon ────────────────────────────────────────────────── */
  .input-field__icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--input-field-icon-color, currentColor);
  }

  .input-field__icon--right {
    order: 1;
  }

  /* ── Help text ───────────────────────────────────────────── */
  .input-field__help {
    font-size: var(--font-size-sm);
    color: var(--input-field-help-color, var(--color-fg-muted));
    margin: 0;
  }

  .input-field__error {
    font-size: var(--font-size-xs);
    color: var(--input-field-error-color, var(--color-danger-fg));
  }

  /* ── Slotted input base ──────────────────────────────────────
   * Targets any input slotted inside the wrapper — no class
   * required on the concrete input elements.
  ─────────────────────────────────────────────────────────── */
  :global(.input-field__wrapper input) {
    flex: 1;
    min-width: 0;
    padding-block: var(--input-control-input-padding-block, var(--spacing-2-5));
    border: none;
    outline: none;
    background-color: transparent;
    font-size: inherit;
    color: var(--input-control-input-color, inherit);
  }

  /* Sizes - applied via wrapper modifier, targets slotted input */
  :global(.input-field__wrapper--sm input) {
    height: var(--spacing-9);
    font-size: var(--font-size-sm);
  }

  :global(.input-field__wrapper--md input) {
    height: var(--spacing-10);
  }

  :global(.input-field__wrapper--lg input) {
    height: var(--spacing-11);
    font-size: var(--font-size-lg);
  }

  /* Disabled text */
  :global(.input-field__wrapper input:disabled) {
    color: var(--input-control-input-disabled-color, var(--color-fg-disabled));
    -webkit-text-fill-color: var(--input-control-input-disabled-color, var(--color-fg-disabled));
  }

  /* ── Placeholder ─────────────────────────────────────────────
   * Default mode: always visible.
   * Floating variants: hidden at rest, fades in on focus.
  ─────────────────────────────────────────────────────────── */
  :global(.input-field__wrapper input::placeholder) {
    opacity: 1;
    color: var(--input-control-input-placeholder-color, var(--color-fg-muted));
  }

  :global(.input-field__wrapper--error input::placeholder) {
    color: var(--input-control-input-placeholder-error-color, var(--color-danger-fg));
  }

  /* Show invalid placeholder color only for forms using native validation UX. */
  :global(form:not([novalidate]) .input-field__wrapper input:user-invalid::placeholder) {
    color: var(--input-control-input-placeholder-error-color, var(--color-danger-fg));
  }

  :global(.input-field__wrapper--over input::placeholder),
  :global(.input-field__wrapper--in input::placeholder),
  :global(.input-field__wrapper--on input::placeholder) {
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  :global(.input-field__wrapper--over input:focus::placeholder),
  :global(.input-field__wrapper--in input:focus::placeholder),
  :global(.input-field__wrapper--on input:focus::placeholder) {
    opacity: 1;
  }

  /* ── "In" variant: push cursor below the floated label ────── */
  :global(.input-field__wrapper--in input) {
    padding-block-start: var(--spacing-5);
    padding-block-end: var(--spacing-1);
  }
</style>
