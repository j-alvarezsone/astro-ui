---
import type { IconProps } from 'astro-icon/components';
import type { InputTextPassThrough } from '@/types/theme/form/inputText';
import type { ClassValue } from '@/types/theme/form/shared';
import { mergePassThroughAttributes, splitPassThroughAttributes } from '@utils/theme/passThrough';

import InputField from './InputField.astro';

interface Props extends Omit<astroHTML.JSX.InputHTMLAttributes, 'class'> {
  name: string;
  placeholder: string;
  label: string;
  required?: boolean;
  type?: 'text' | 'number';
  icon?: IconProps;
  iconPos?: 'left' | 'right';
  sizes?: 'sm' | 'md' | 'lg';
  errorText?: string;
  helpText?: string;
  labelPosition?: 'default' | 'over' | 'in' | 'on';
  disabled?: boolean;
  minLength?: number;
  maxLength?: number;
  min?: number;
  max?: number;
  pattern?: string;
  class?: ClassValue;
  pt?: InputTextPassThrough;
}

const {
  name,
  placeholder,
  label,
  required = false,
  type = 'text',
  icon,
  iconPos = 'right',
  sizes = 'md',
  errorText,
  helpText,
  labelPosition = 'default',
  disabled = false,
  minLength,
  maxLength,
  min,
  max,
  pattern,
  class: className,
  pt,
  ...inputAttributes
} = Astro.props;

const errorTextId = errorText ? `${name}-error` : undefined;
const helpTextId = helpText ? `${name}-help` : undefined;
const describedBy = [errorTextId, helpTextId].filter(Boolean).join(' ') || undefined;

const inputPassThrough = mergePassThroughAttributes(inputAttributes, pt?.input);
const { className: inputPassThroughClass, attributes: inputPassThroughAttributes } =
  splitPassThroughAttributes(inputPassThrough);
---

<InputField
  name={name}
  label={label}
  labelPosition={labelPosition}
  sizes={sizes}
  icon={icon}
  iconPos={iconPos}
  errorText={errorText}
  helpText={helpText}
  class={className}
  pt={pt}
>
  <input
    id={name}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    minlength={minLength}
    maxlength={maxLength}
    min={min}
    max={max}
    pattern={pattern}
    aria-describedby={describedBy}
    aria-invalid={errorText ? 'true' : undefined}
    class:list={inputPassThroughClass}
    {...inputPassThroughAttributes}
  />
</InputField>
