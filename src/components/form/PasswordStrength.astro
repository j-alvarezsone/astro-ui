---
interface Props {
  inputId: string;
  panelId: string;
  statusId: string;
  hintsId?: string;
  promptLabel?: string;
  promptSubLabel?: string;
  weakLabel?: string;
  mediumLabel?: string;
  strongLabel?: string;
  showHints?: boolean;
  visibleOnFocus?: boolean;
  rules?: PasswordStrengthRule[];
}

export interface PasswordStrengthRule {
  id: string;
  label: string;
  pattern?: string;
  minLength?: number;
  useInputPattern?: boolean;
}

const DEFAULT_STRENGTH_RULES: PasswordStrengthRule[] = [
  { id: 'lower', label: 'At least one lowercase', pattern: '[a-z]' },
  { id: 'upper', label: 'At least one uppercase', pattern: '[A-Z]' },
  { id: 'number', label: 'At least one numeric', pattern: '\\d' },
  { id: 'special', label: 'At least one special character', pattern: '[^\\w\\s]' },
  { id: 'length', label: 'Minimum 8 characters', minLength: 8 },
];

const {
  inputId,
  panelId,
  statusId,
  hintsId,
  promptLabel = 'Enter a password',
  promptSubLabel = '',
  weakLabel = 'Weak',
  mediumLabel = 'Medium',
  strongLabel = 'Strong',
  showHints = true,
  visibleOnFocus = true,
  rules,
} = Astro.props;

const resolvedRules = rules && rules.length > 0 ? rules : DEFAULT_STRENGTH_RULES;
---

<password-strength
  class="password-strength"
  data-input-id={inputId}
  data-visible-on-focus={visibleOnFocus ? 'true' : 'false'}
  data-show-hints={showHints ? 'true' : 'false'}
  data-label-weak={weakLabel}
  data-label-medium={mediumLabel}
  data-label-strong={strongLabel}
  data-placement="bottom"
  data-open="false"
>
  <div id={panelId} class="password-strength__panel" role="status" aria-live="off">
    <p id={statusId} class="password-strength__label">
      {promptLabel}
    </p>

    <div
      class="password-strength__meter"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="3"
      aria-valuenow="0"
      aria-valuetext={promptLabel}
      data-empty-label={promptLabel}
      aria-labelledby={statusId}
      data-strength-meter
    >
      <span class="password-strength__meter-fill" data-strength-meter-fill></span>
    </div>
    <p id={statusId} class="password-strength__sub-label">
      {promptSubLabel}
    </p>
    {
      showHints && (
        <ul id={hintsId} class="password-strength__hints" data-strength-hints>
          {resolvedRules.map((rule) => (
            <li
              class="password-strength__hint"
              data-rule-id={rule.id}
              data-rule-pattern={rule.pattern}
              data-rule-min-length={typeof rule.minLength === 'number' ? String(rule.minLength) : undefined}
              data-rule-use-input-pattern={rule.useInputPattern ? 'true' : undefined}
            >
              {rule.label}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</password-strength>

<script>
  import '@web-components/password-strength.web';
</script>

<style>
  password-strength.password-strength {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 0;
    overflow: visible;
    z-index: 10;
    pointer-events: none;
  }

  .password-strength__panel {
    position: absolute;
    inset-inline: 0;
    background-color: var(--password-strength-panel-background, var(--color-surface));
    border: 1px solid var(--password-strength-panel-border, var(--color-border));
    border-radius: var(--password-strength-panel-radius, var(--rounded-md));
    box-shadow: var(
      --password-strength-panel-shadow,
      0 8px 16px color-mix(in srgb, var(--color-contrast-fill) 12%, transparent)
    );
    display: grid;
    gap: var(--password-strength-panel-gap, var(--spacing-2));

    pointer-events: none;
    padding: var(--password-strength-panel-padding, var(--spacing-3));
    transform: translateY(var(--password-strength-closed-offset, var(--spacing-1)));
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    visibility: hidden;
    width: 100%;
  }

  .password-strength__panel {
    top: var(--ps-top, auto);
  }

  .password-strength[data-open='true'] .password-strength__panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .password-strength__label {
    color: var(--password-strength-label-color, var(--color-fg-muted));
    font-size: var(--font-size-base);
    margin: 0;
  }
  .password-strength__sub-label {
    color: var(--password-strength-sub-label-color, var(--color-fg-muted));
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .password-strength[data-strength='weak'] .password-strength__label {
    color: var(--password-strength-weak-color, var(--color-danger-fill));
  }

  .password-strength[data-strength='medium'] .password-strength__label {
    color: var(--password-strength-medium-color, var(--color-warning-fill));
  }

  .password-strength[data-strength='strong'] .password-strength__label {
    color: var(--password-strength-strong-color, var(--color-success-fill));
  }

  .password-strength__meter {
    background-color: var(--password-strength-meter-background, var(--color-contrast-border));
    border-radius: var(--password-strength-meter-radius, var(--rounded-full));
    height: var(--password-strength-meter-height, var(--spacing-2-5));
    overflow: hidden;
    width: 100%;
  }

  .password-strength__meter-fill {
    background-color: var(--password-strength-meter-empty-color, var(--color-contrast-border));
    border-radius: inherit;
    display: block;
    height: 100%;
    transition:
      width 180ms ease,
      background-color 180ms ease;
    width: 0;
  }

  .password-strength[data-strength='weak'] .password-strength__meter-fill {
    background-color: var(--password-strength-meter-weak-color, var(--color-danger-fill));
    width: 33%;
  }

  .password-strength[data-strength='medium'] .password-strength__meter-fill {
    background-color: var(--password-strength-meter-medium-color, var(--color-warning-fill));
    width: 66%;
  }

  .password-strength[data-strength='strong'] .password-strength__meter-fill {
    background-color: var(--password-strength-meter-strong-color, var(--color-success-fill));
    width: 100%;
  }

  .password-strength__hints {
    color: var(--password-strength-hints-color, var(--color-fg-muted));
    font-size: var(--font-size-sm);
    line-height: 1.35;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .password-strength__hint {
    margin: 0;
  }

  .password-strength__hint[data-passed='true'] {
    color: var(--password-strength-hint-passed-color, var(--color-success-fg));
  }
</style>
