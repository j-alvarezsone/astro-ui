---
import ComponentSlotsDemo from '@components/theme/ComponentSlotsDemo.astro';
import ThemeDocArticle from '@components/theme/ThemeDocArticle.astro';
import ThemeLayout from '@layouts/ThemeLayout.astro';
import { createComponentSlots } from '@utils/content/createComponentSlots';
import { getFilteredHeadings } from '@utils/content/getFilteredHeadings';
import InputFieldComponent from '@components/form/InputField.astro';
import { INPUT_FIELD_PT_SLOT_NAMES, INPUT_FIELD_SELECTOR_OVERRIDES } from '@/types/theme/form/inputField';
import { getEntry, render } from 'astro:content';

const INPUT_FIELD_SLOTS = createComponentSlots(
  'input-field',
  INPUT_FIELD_PT_SLOT_NAMES,
  INPUT_FIELD_SELECTOR_OVERRIDES,
);

const guide = await getEntry('themeGuides', 'input-field-reference');

if (!guide) {
  throw new Error('Theme guide entry "input-field-reference" was not found.');
}

const rendered = await render(guide);
const { Content } = rendered;
const headings = getFilteredHeadings(rendered);
---

<ThemeLayout
  title="InputField Documentation"
  heroTitle={guide.data.title}
  heroSummary={guide.data.summary}
  secondaryHref="/theme-system/input-text"
  secondaryLabel="InputText Documentation"
  contentLabel="InputField documentation content"
  headings={headings}
>
  <ComponentSlotsDemo slots={INPUT_FIELD_SLOTS} label="InputField pt slots">
    <InputFieldComponent
      name="demo-input-field"
      label="Username"
      icon={{ name: 'mdi:account' }}
      helpText="Choose a unique username."
      errorText="Username is already taken."
    >
      <input id="demo-input-field" name="demo-input-field" type="text" placeholder="username" aria-invalid="true" />
    </InputFieldComponent>
  </ComponentSlotsDemo>

  <ThemeDocArticle>
    <Content />
  </ThemeDocArticle>
</ThemeLayout>
