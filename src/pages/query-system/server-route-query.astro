---
import Button from '@components/Button.astro';
import Heading from '@components/typography/Heading.astro';
import Layout from '@layouts/Layout.astro';
import { useServerQuery } from '@utils/query';
import { getAllHeroesOptions } from '@queries/heroes';

export const prerender = false;

const renderedAt = new Date().toISOString();

const { data: heroes } = await useServerQuery({
  queryFn: getAllHeroesOptions.queryFn,
  routeCache: {
    cache: Astro.cache,
    maxAge: 10000,
    tags: ['heroes'],
  },
  meta: { baseUrl: Astro.url },
});

const isRouteCacheBridgeEnabled = Astro.cache.enabled !== false;
---

<Layout title="Server Route Query Demo" uiTheme="warm">
  <div class="container">
    {
      heroes && (
        <section class="query-demo" aria-label="Heroes server route query demo">
          <Heading as="h3" weight="semibold">
            Server Route Query: Heroes
          </Heading>

          <ul data-heroes-list class="query-demo__list">
            {heroes.items.map((hero) => (
              <li class="query-demo__item">
                {hero.name}
                {' - '}
                {hero.power}
              </li>
            ))}
          </ul>

          <add-hero class="add-hero">
            <div class="query-demo__actions">
              <span data-hero-action="add">
                <Button label="Add Hero" variant="primary" size="sm" />
              </span>
              <span data-hero-action="reset">
                <Button label="Reset Heroes" variant="danger" size="sm" />
              </span>
            </div>
          </add-hero>

          <section class="query-cache-debug" aria-labelledby="heroes-query-cache-debug-title">
            <Heading as="h4" id="heroes-query-cache-debug-title" weight="semibold">
              Query Cache Debug
            </Heading>

            <dl class="query-cache-debug__grid">
              <div>
                <dt>Cache mode</dt>
                <dd>route</dd>
              </div>
              <div>
                <dt>Query cache hit</dt>
                <dd>
                  n/a in route mode
                  <span class="query-cache-debug__hint">
                    `isFromCache` applies to query-store cache mode. Route mode uses uncached query execution and relies
                    on Astro route-cache directives.
                  </span>
                </dd>
              </div>
              <div>
                <dt>Route cache bridge</dt>
                <dd>{isRouteCacheBridgeEnabled ? 'configured' : 'disabled in this runtime'}</dd>
              </div>
              <div>
                <dt>Route cache status legend</dt>
                <dd>
                  HIT (fresh): served within maxAge. HIT (stale): served within swr while revalidating. MISS: no usable
                  entry for this execution.
                  <span class="query-cache-debug__hint">
                    Right after tag/path invalidation, edge nodes can still respond with a stale status briefly during
                    propagation and revalidation. This is expected with route cache + SWR.
                  </span>
                </dd>
              </div>
              <div>
                <dt>Why first add can look stale</dt>
                <dd>
                  This page uses route caching with <strong>maxAge=10000ms</strong> and <strong>swr=50000ms</strong>.
                  After adding a hero, tag invalidation is triggered, but edge cache propagation is not always immediate
                  across nodes. A request to the same base URL can still return a cached HIT or stale-forwarded response
                  for a short window.
                  <span class="query-cache-debug__hint">
                    Navigating to the same page with a unique query parameter (for example <code>?__refresh=...</code>)
                    creates a different cache key when query variation is enabled, which commonly forces a MISS and
                    shows the newly created hero right away.
                  </span>
                </dd>
              </div>
              <div>
                <dt>Rendered at</dt>
                <dd>{renderedAt}</dd>
              </div>
              <div>
                <dt>Tags</dt>
                <dd>
                  {['heroes'].join(', ')}
                  <span class="query-cache-debug__hint">
                    Labels used to invalidate related cached responses together.
                  </span>
                </dd>
              </div>
              <div>
                <dt>maxAge</dt>
                <dd>
                  10000ms
                  <span class="query-cache-debug__hint">
                    How long route cache marks responses fresh before serving stale via SWR.
                  </span>
                </dd>
              </div>
              <div>
                <dt>swr</dt>
                <dd>
                  50000ms
                  <span class="query-cache-debug__hint">
                    Additional stale-while-revalidate window after maxAge expires.
                  </span>
                </dd>
              </div>
            </dl>
          </section>
        </section>
      )
    }
  </div>
</Layout>

<script>
  import '@web-components/add-hero.web';
</script>

<style>
  .container {
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .query-demo {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    border: 1px solid var(--color-contrast-border);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-4);
    background: var(--color-contrast-subtle);
  }

  .query-demo__list {
    display: grid;
    gap: var(--spacing-1);
    margin: 0;
    padding-left: var(--spacing-4);
  }

  .query-demo__item {
    display: grid;
  }

  .query-demo__actions {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }

  .query-cache-debug {
    margin-top: var(--spacing-3);
    display: grid;
    gap: var(--spacing-3);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-3);
    background: var(--color-primary-subtle);
  }

  .query-cache-debug__grid {
    display: grid;
    gap: var(--spacing-2);
    margin: 0;
  }

  .query-cache-debug__grid div {
    display: grid;
    gap: var(--spacing-1);
  }

  .query-cache-debug__grid dt {
    font-weight: 600;
  }

  .query-cache-debug__grid dd {
    margin: 0;
  }

  .query-cache-debug__hint {
    display: block;
    margin-top: var(--spacing-1);
    color: var(--color-fg-muted);
    font-size: var(--font-size-sm);
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .query-cache-debug__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
