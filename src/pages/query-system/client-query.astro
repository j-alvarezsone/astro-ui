---
import Button from '@components/Button.astro';
import Loader from '@components/Loader.astro';
import Heading from '@components/typography/Heading.astro';
import Layout from '@layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Client Query Demo" uiTheme="warm">
  <div class="container">
    <section class="query-demo" aria-label="Pets client query demo">
      <Heading as="h3" weight="semibold"> Client Query: Pets </Heading>

      <p class="query-note">Fetch starts automatically on mount. Loader is shown while pending or fetching.</p>

      <fetch-pets-query class="fetch-pets-query">
        <div data-pets-loader class="fetch-pets-query__loader" hidden>
          <Loader size="sm" isTextVisible />
        </div>
        <p data-pets-error class="query-demo__error" hidden></p>
        <ul data-pets-list class="query-demo__list" hidden></ul>
      </fetch-pets-query>

      <add-pet class="add-pet">
        <Button label="Add Pet" variant="primary" size="sm" />
      </add-pet>
    </section>
  </div>
</Layout>

<script>
  import '@web-components/fetch-pets-query.web';
  import '@web-components/add-pet.web';
</script>

<style>
  .container {
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .query-demo {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    border: 1px solid var(--color-contrast-border);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-4);
    background: var(--color-contrast-subtle);
  }

  .query-note {
    margin: 0;
  }

  fetch-pets-query.fetch-pets-query {
    display: grid;
    gap: var(--spacing-2);
  }

  .fetch-pets-query__loader {
    display: none;
  }

  .fetch-pets-query__loader:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .query-demo__list {
    display: grid;
    gap: var(--spacing-1);
    margin: 0;
    padding-left: var(--spacing-4);
  }

  .query-demo__error {
    color: var(--color-danger-fg);
    margin: 0;
  }
</style>
