---
import Button from '@components/Button.astro';
import Heading from '@components/typography/Heading.astro';
import Layout from '@layouts/Layout.astro';
import { useServerQuery } from '@utils/query';
import { getAllUsersOptions } from '@queries/users';

export const prerender = false;

const renderedAt = new Date().toISOString();

const { data: users, isFromCache } = await useServerQuery({
  ...getAllUsersOptions,
  tags: ['users'],
  swr: 3000,
  meta: { baseUrl: Astro.url, astroCache: Astro.cache },
});

const isRouteCacheBridgeEnabled = Astro.cache.enabled !== false;
---

<Layout title="Server Query Demo" uiTheme="warm">
  <div class="container">
    {
      users && (
        <section class="query-demo" aria-label="Users server query demo">
          <Heading as="h3" weight="semibold">
            Server Query: Users
          </Heading>

          <ul data-users-list class="query-demo__list">
            {users.items.map((user) => (
              <li class="query-demo__item">{user.name}</li>
            ))}
          </ul>

          <add-user class="add-user">
            <Button label="Add User" variant="primary" size="sm" />
          </add-user>

          <section class="query-cache-debug" aria-labelledby="query-cache-debug-title">
            <Heading as="h4" id="query-cache-debug-title" weight="semibold">
              Query Cache Debug
            </Heading>

            <dl class="query-cache-debug__grid">
              <div>
                <dt>isFromCache</dt>
                <dd>{String(isFromCache)}</dd>
              </div>
              <div>
                <dt>Route cache bridge</dt>
                <dd>{isRouteCacheBridgeEnabled ? 'configured' : 'disabled in this runtime'}</dd>
              </div>
              <div>
                <dt>Rendered at</dt>
                <dd>{renderedAt}</dd>
              </div>
              <div>
                <dt>Query key</dt>
                <dd>{JSON.stringify(['users'])}</dd>
              </div>
              <div>
                <dt>Tags</dt>
                <dd>
                  {['users'].join(', ')}
                  <span class="query-cache-debug__hint">
                    Labels used to invalidate related cached responses together.
                  </span>
                </dd>
              </div>
              <div>
                <dt>staleTime</dt>
                <dd>
                  10000ms
                  <span class="query-cache-debug__hint">
                    How long query data is treated as fresh before a refetch is needed.
                  </span>
                </dd>
              </div>
              <div>
                <dt>swr</dt>
                <dd>
                  3000ms
                  <span class="query-cache-debug__hint">
                    Not a fixed wait for the next fetch: after staleTime expires, stale data can still be served for up to 3000ms while a background refresh runs (for example, at 11s old data can be shown once and refreshed in parallel).
                  </span>
                </dd>
              </div>
            </dl>
          </section>
        </section>
      )
    }
  </div>
</Layout>

<script>
  import '@web-components/add-user.web';
</script>

<style>
  .container {
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .query-demo {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    border: 1px solid var(--color-contrast-border);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-4);
    background: var(--color-contrast-subtle);
  }

  .query-demo__list {
    display: grid;
    gap: var(--spacing-1);
    margin: 0;
    padding-left: var(--spacing-4);
  }

  .query-demo__item {
    display: grid;
  }

  .query-cache-debug {
    margin-top: var(--spacing-3);
    display: grid;
    gap: var(--spacing-3);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-3);
    background: var(--color-primary-subtle);
  }

  .query-cache-debug__grid {
    display: grid;
    gap: var(--spacing-2);
    margin: 0;
  }

  .query-cache-debug__grid div {
    display: grid;
    gap: var(--spacing-1);
  }

  .query-cache-debug__grid dt {
    font-weight: 600;
  }

  .query-cache-debug__grid dd {
    margin: 0;
  }

  .query-cache-debug__hint {
    display: block;
    margin-top: var(--spacing-1);
    color: var(--color-fg-muted);
    font-size: var(--font-size-sm);
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .query-cache-debug__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
