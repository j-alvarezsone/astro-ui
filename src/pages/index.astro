---
import Button from '@components/Button.astro';
import Form from '@components/form/Form.astro';
import FormGroup from '@components/form/FormGroup.astro';
import InputAddon from '@components/form/input-group/InputAddon.astro';
import InputGroup from '@components/form/input-group/InputGroup.astro';
import InputEmail from '@components/form/InputEmail.astro';
import InputPassword from '@components/form/InputPassword.astro';
import InputText from '@components/form/InputText.astro';
import TextArea from '@components/form/TextArea.astro';
import Chips from '@components/misc/Chips.astro';
import Divider from '@components/Divider.astro';
import Heading from '@components/typography/Heading.astro';
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout uiTheme="warm">
  <div class="container">
    <Heading weight="bold">Hello world</Heading>
    <Button class="test" as="button" icon={{ name: 'mdi:account-alert' }} variant="success" />
    <p>
      This is a starter template for building your first Astro project. It comes with a few example pages and components
      to help you get started.
    </p>
    <form class="demo-form">
      <InputEmail
        name="email"
        label="Email"
        placeholder="name@example.com"
        required
        labelPosition="default"
        value="test"
      />
      <InputPassword
        name="password"
        label="Password"
        placeholder="Enter your password"
        required
        labelPosition="default"
        value="test"
        promptSubLabel="Reset password"
      />
      <InputPassword
        name="passwordCustom"
        label="Password (Custom Rules)"
        placeholder="Use 10+ chars with upper/lower/number/symbol"
        required
        labelPosition="default"
        minLength={10}
        pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{10,}"
        promptLabel="Create a strong password"
        weakLabel="Needs work"
        mediumLabel="Almost there"
        strongLabel="Great password"
        strengthRules={[
          { id: 'lower', label: 'Contains a lowercase letter', pattern: '[a-z]' },
          { id: 'upper', label: 'Contains an uppercase letter', pattern: '[A-Z]' },
          { id: 'number', label: 'Contains a number', pattern: '\\d' },
          { id: 'special', label: 'Contains a special character', pattern: '[^\\w\\s]' },
          { id: 'length', label: 'Minimum 10 characters', minLength: 10 },
          { id: 'pattern', label: 'Matches the full password policy', useInputPattern: true },
        ]}
      />
      <TextArea
        name="details"
        label="Details"
        placeholder="Enter details..."
        required
        minLength={3}
        sizes="md"
        labelPosition="default"
        value="test"
      />

      <FormGroup legend="Validation states demo">
        <InputText
          name="test"
          label="Test"
          icon={{ name: 'mdi:account-alert' }}
          iconPos="right"
          helpText="Required. Minimum 4 characters."
          labelPosition="on"
          placeholder="Type at least 4 chars"
          sizes="md"
          required
          minLength={4}
          autofocus
        />
        <InputText
          name="age"
          label="Age"
          helpText="Required. Must be between 18 and 99."
          labelPosition="default"
          placeholder="18"
          sizes="md"
          type="number"
          required
        />
      </FormGroup>
      <Button as="button" type="submit" label="Submit Form" />
    </form>

    <Form initialValues={{ username: 'test', price: 42, details: 'test' }} class="demo-form">
      <InputGroup>
        <InputAddon>
          <Icon name="mdi:account" />
        </InputAddon>
        <InputText name="username" label="Username" placeholder="Username" />
      </InputGroup>

      <InputGroup>
        <InputAddon>$</InputAddon>
        <InputText name="price" label="Price" placeholder="Price" type="number" />
        <InputAddon>.00</InputAddon>
      </InputGroup>

      <TextArea
        name="details"
        label="Details"
        placeholder="Enter details..."
        required
        minLength={3}
        sizes="md"
        labelPosition="default"
      />

      <Button slot="reset" as="button" type="reset" label="Reset" />
      <Button slot="submit" as="button" type="submit" label="Submit" />
    </Form>

    <!-- Outline button variants demo -->
    <div style="display: flex; flex-direction: column; gap: var(--spacing-3);">
      <Heading as="h3" weight="bold">Outline Variants</Heading>
      <div style="display: flex; gap: var(--spacing-2); flex-wrap: wrap;">
        <Button as="button" variant="primary" outline label="Primary Outline" />
        <Button as="button" variant="secondary" outline label="Secondary Outline" />
        <Button as="button" variant="contrast" outline label="Contrast Outline" />
        <Button as="button" variant="success" outline label="Success Outline" />
        <Button as="button" variant="warning" outline label="Warning Outline" />
        <Button as="button" variant="danger" outline label="Danger Outline" />
      </div>
    </div>

    <InputText
      name="firstName"
      label="First name"
      placeholder="Type..."
      pt={{ wrapper: { class: 'input-text-wrapper-custom', id: 'wrapper' } }}
    />
    <InputText name="lastName" label="Last name" placeholder="Type..." />
    <InputText
      name="email"
      label="Email"
      placeholder="name@example.com"
      pt={{
        root: { class: 'email-field-root' },
        wrapper: { style: '--input-field-wrapper-background: pink; letter-spacing: 0.02em;' },
        input: { class: 'email-input' },
        helpText: { class: 'email-help' },
        errorText: { class: 'email-error' },
      }}
    />
    <InputText
      name="email"
      label="Email"
      placeholder="name@example.com"
      pt={{
        root: { class: 'email-field-root' },
        wrapper: { class: ['email-shell', 'email-shell--compact', 'email-shell--info'] },
        input: { class: 'email-input' },
        helpText: { class: 'email-help' },
        errorText: { class: 'email-error' },
      }}
    />
    <Chips
      label="test"
      image={{ src: 'https://i.pravatar.cc/96?img=21', alt: 'Amy Elsner avatar' }}
      icon={{ name: 'mdi:abugida-thai' }}
      size="md"
      removable
    />

    <Heading weight="semibold">Divider</Heading>

    <Divider />

    <Divider align="left">Left</Divider>
    <Divider align="center">Center</Divider>
    <Divider align="right">Right</Divider>

    <Divider type="dashed" align="center">Dashed</Divider>
    <Divider type="dotted" align="center">Dotted</Divider>

    <div style="display: flex; height: 200px; align-items: center; gap: var(--spacing-4);">
      <p style="flex: 1;">Left content area</p>
      <Divider layout="vertical" align="center">OR</Divider>
      <p style="flex: 1;">Right content area</p>
    </div>
  </div>
</Layout>

<style>
  .container {
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
  /* Root-level scope class:
     useful to scope all nested field styling in one area. */
  :global(.email-field-root .input-field__wrapper) {
    --input-field-wrapper-focus-ring-color: var(--color-link-border);
  }

  /* Wrapper base class (1 responsibility) */
  :global(.email-shell) {
    --input-field-wrapper-background: var(--color-primary-subtle);
    --input-field-wrapper-border-color: var(--color-primary-border);
  }

  /* Wrapper modifier class (2nd responsibility) */
  :global(.email-shell--compact) {
    --input-field-wrapper-padding-inline: var(--spacing-2);
  }

  /* Wrapper state/variant class (3rd responsibility) */
  :global(.email-shell--info) {
    --input-field-wrapper-border-color: var(--color-link-border);
  }

  /* Native CSS property override via class:
     use higher specificity than .input-field__wrapper to win cascade. */
  :global(.input-field__wrapper.email-shell.email-shell--info) {
    background-color: blue;
    border-color: blue;
  }

  /* Input class has its own separate responsibility */
  :global(.email-input) {
    --input-control-input-color: var(--color-fg);
  }
</style>
