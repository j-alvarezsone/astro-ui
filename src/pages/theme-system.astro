---
import Heading from '@components/typography/Heading.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const guides = (await getCollection('themeGuides')).toSorted((left, right) => left.data.order - right.data.order);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
});

const guideSections = await Promise.all(
  guides.map(async (entry) => {
    const rendered = await render(entry);
    const { Content } = rendered;
    const headings =
      'headings' in rendered && Array.isArray(rendered.headings)
        ? rendered.headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)
        : [];

    return {
      entry,
      Content,
      headings,
      updatedLabel: entry.data.updatedAt ? dateFormatter.format(entry.data.updatedAt) : null,
    };
  }),
);
---

<Layout title="Theme System Guide">
  <main class="theme-guide-shell">
    <div class="theme-guide-backdrop" aria-hidden="true"></div>

    <section class="theme-guide-hero" aria-labelledby="theme-guide-title">
      <p class="theme-guide-hero__kicker">Theme Documentation</p>
      <Heading as="h1" size="5xl" weight="bold" id="theme-guide-title">
        Build UI themes with a cleaner system, not scattered overrides.
      </Heading>
      <p class="theme-guide-hero__lede">
        This standalone playbook explains how typed theme objects become runtime CSS variables, and how to extend the
        system without introducing token chaos.
      </p>
      <div class="theme-guide-hero__meta">
        <span>{guideSections.length} guide{guideSections.length === 1 ? '' : 's'}</span>
        <span>Astro content collection</span>
        <span>Theme-first architecture</span>
      </div>
    </section>

    <section class="theme-guide-layout" aria-label="Theme guide content">
      <aside class="theme-guide-index" aria-label="Guide index">
        <Heading as="h2" size="lg" weight="bold">On This Page</Heading>
        <ol>
          {
            guideSections.map(({ entry, headings }) => (
              <li class="theme-guide-index__guide">
                <a href={`#${entry.id}`}>{entry.data.title}</a>
                {headings.length > 0 && (
                  <ol class="theme-guide-index__sections">
                    {headings.map((heading) => (
                      <li
                        class:list={[
                          'theme-guide-index__section',
                          `theme-guide-index__section--depth-${heading.depth}`,
                        ]}
                      >
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))
          }
        </ol>
      </aside>

      <div class="theme-guide-stack">
        {
          guideSections.map(({ entry, Content, updatedLabel }, index) => (
            <article class="theme-guide-card" id={entry.id}>
              <header class="theme-guide-card__header">
                <p class="theme-guide-card__eyebrow">Guide {index + 1}</p>
                <Heading as="h2" size="3xl" weight="bold">
                  {entry.data.title}
                </Heading>
                <p>{entry.data.summary}</p>
                {updatedLabel && <span class="theme-guide-card__date">Updated {updatedLabel}</span>}
              </header>
              <div class="theme-guide-content">
                <Content />
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .theme-guide-shell {
    --theme-guide-surface: color-mix(in oklab, var(--color-surface) 94%, #fff 6%);
    --theme-guide-border: color-mix(in oklab, var(--color-border) 72%, #8ea3b8 28%);
    --theme-guide-ink: color-mix(in oklab, var(--color-fg) 88%, #1d2e46 12%);

    position: relative;
    isolation: isolate;
    width: min(1120px, 100% - (var(--spacing-4) * 2));
    margin-inline: auto;
    padding-block: clamp(var(--spacing-7), 6vw, var(--spacing-12));
    padding-inline: var(--spacing-4);
    display: grid;
    gap: clamp(var(--spacing-5), 2vw, var(--spacing-8));
    overflow-x: clip;
  }

  .theme-guide-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--rounded-4xl);
    background:
      radial-gradient(42rem 23rem at 0% 0%, color-mix(in oklab, #0f2f63 21%, transparent), transparent),
      radial-gradient(30rem 18rem at 100% 2%, color-mix(in oklab, #16a34a 20%, transparent), transparent),
      linear-gradient(160deg, #f8fafc 0%, #eff6ff 44%, #f0fdf4 100%);
    box-shadow: 0 30px 70px rgba(8, 15, 30, 0.08);
  }

  .theme-guide-hero {
    padding: clamp(var(--spacing-4), 2.5vw, var(--spacing-8));
    border: 1px solid var(--theme-guide-border);
    border-radius: var(--rounded-3xl);
    background: color-mix(in oklab, var(--theme-guide-surface) 70%, #f7fbff 30%);
    backdrop-filter: blur(4px);
  }

  .theme-guide-hero__kicker {
    margin: 0;
    color: color-mix(in oklab, var(--color-primary-fg) 75%, #3b82f6 25%);
    font-weight: var(--font-weight-medium);
    font-size: clamp(0.75rem, 0.7rem + 0.26vw, 0.88rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .theme-guide-hero :global(h1.heading) {
    max-width: 24ch;
    margin-block: var(--spacing-3) var(--spacing-4);
    color: var(--theme-guide-ink);
    font-size: clamp(1.8rem, 1.35rem + 2.1vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .theme-guide-hero__lede {
    margin: 0;
    max-width: 68ch;
    color: color-mix(in oklab, var(--color-fg-muted) 90%, #111827 10%);
    font-size: clamp(var(--font-size-base), 0.95rem + 0.35vw, var(--font-size-lg));
    line-height: 1.45;
  }

  .theme-guide-hero__meta {
    margin-top: var(--spacing-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .theme-guide-hero__meta span {
    padding: var(--spacing-1) var(--spacing-3);
    border: 1px solid color-mix(in oklab, var(--theme-guide-border) 85%, #9ca3af 15%);
    border-radius: var(--rounded-full);
    background-color: color-mix(in oklab, var(--color-surface) 72%, #f3f4f6 28%);
    font-size: var(--font-size-sm);
    color: color-mix(in oklab, var(--color-fg-muted) 70%, var(--color-fg) 30%);
  }

  .theme-guide-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
    gap: clamp(var(--spacing-4), 2vw, var(--spacing-7));
    align-items: start;
  }

  .theme-guide-index {
    position: sticky;
    top: var(--spacing-6);
    padding: var(--spacing-4);
    border: 1px solid var(--theme-guide-border);
    border-radius: var(--rounded-xl);
    background: color-mix(in oklab, var(--color-surface) 70%, #f8fafc 30%);
  }

  .theme-guide-index :global(h2.heading) {
    margin: 0 0 var(--spacing-3);
    font-size: clamp(var(--font-size-base), 0.92rem + 0.2vw, var(--font-size-lg));
  }

  .theme-guide-index ol {
    margin: 0;
    padding-left: var(--spacing-4);
    display: grid;
    gap: var(--spacing-2);
  }

  .theme-guide-index__guide {
    display: grid;
    gap: var(--spacing-1-5);
  }

  .theme-guide-index__sections {
    margin: 0;
    padding-left: var(--spacing-4);
    display: grid;
    gap: var(--spacing-1);
  }

  .theme-guide-index__section {
    font-size: var(--font-size-sm);
  }

  .theme-guide-index__section--depth-3 {
    opacity: 0.85;
  }

  .theme-guide-index a {
    color: color-mix(in oklab, var(--color-primary-fg) 70%, #1d4ed8 30%);
    text-decoration: none;
  }

  .theme-guide-index a:hover {
    text-decoration: underline;
  }

  .theme-guide-stack {
    display: grid;
    gap: clamp(var(--spacing-4), 2vw, var(--spacing-6));
  }

  .theme-guide-card {
    border: 1px solid var(--theme-guide-border);
    border-radius: var(--rounded-2xl);
    background-color: color-mix(in oklab, var(--theme-guide-surface) 85%, #ffffff 15%);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
    overflow: clip;
  }

  .theme-guide-card__header {
    padding: var(--spacing-5);
    border-bottom: 1px solid color-mix(in oklab, var(--theme-guide-border) 85%, #dbe3ed 15%);
    background: linear-gradient(180deg, color-mix(in oklab, #f1f5f9 66%, #fff 34%), transparent);
  }

  .theme-guide-card__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--font-weight-semibold);
    color: color-mix(in oklab, var(--color-fg-muted) 80%, #0f172a 20%);
  }

  .theme-guide-card__header :global(h2.heading) {
    margin: var(--spacing-2) 0 var(--spacing-3);
    font-size: clamp(var(--font-size-xl), 1rem + 0.8vw, var(--font-size-2xl));
    color: var(--theme-guide-ink);
  }

  .theme-guide-card__header p {
    margin: 0;
    color: color-mix(in oklab, var(--color-fg-muted) 86%, #111827 14%);
  }

  .theme-guide-card__date {
    display: inline-flex;
    margin-top: var(--spacing-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: color-mix(in oklab, var(--color-fg-muted) 70%, #334155 30%);
  }

  .theme-guide-content {
    padding: var(--spacing-5);
    color: color-mix(in oklab, var(--color-fg) 88%, #111827 12%);
    max-width: 72ch;
  }

  .theme-guide-content :global(h2),
  .theme-guide-content :global(h3),
  .theme-guide-content :global(h4) {
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-2);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .theme-guide-content :global(p),
  .theme-guide-content :global(ol),
  .theme-guide-content :global(ul) {
    margin-top: 0;
    margin-bottom: var(--spacing-3);
    line-height: 1.6;
  }

  .theme-guide-content :global(ol),
  .theme-guide-content :global(ul) {
    padding-left: var(--spacing-5);
  }

  .theme-guide-content :global(li + li) {
    margin-top: var(--spacing-1);
  }

  .theme-guide-content :global(p + ul),
  .theme-guide-content :global(p + ol),
  .theme-guide-content :global(ul + p),
  .theme-guide-content :global(ol + p) {
    margin-top: var(--spacing-2);
  }

  .theme-guide-content :global(code) {
    font-size: 0.9em;
    padding: 0.12rem 0.4rem;
    border-radius: var(--rounded-md);
    background-color: color-mix(in oklab, #dbeafe 46%, #ffffff 54%);
  }

  .theme-guide-content :global(pre) {
    margin-top: 0;
    margin-bottom: var(--spacing-4);
    border: 1px solid color-mix(in oklab, var(--theme-guide-border) 85%, #d4d4d8 15%);
    border-radius: var(--rounded-lg);
    background-color: color-mix(in oklab, #0f172a 92%, black 8%);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.18);
  }

  .theme-guide-content :global(pre code) {
    padding: 0;
    border-radius: 0;
    background: transparent;
  }

  @media (max-width: 64rem) {
    .theme-guide-layout {
      grid-template-columns: 1fr;
    }

    .theme-guide-index {
      position: static;
    }
  }

  @media (max-width: 48rem) {
    .theme-guide-shell {
      width: 100%;
      padding-block: var(--spacing-6);
      padding-inline: var(--spacing-3);
    }

    .theme-guide-backdrop {
      border-radius: var(--rounded-2xl);
    }

    .theme-guide-card__header,
    .theme-guide-content {
      padding: var(--spacing-4);
    }

    .theme-guide-hero {
      border-radius: var(--rounded-2xl);
    }

    .theme-guide-hero :global(h1.heading) {
      max-width: 12ch;
      font-size: clamp(1.7rem, 1.2rem + 5vw, 2.4rem);
    }
  }
</style>
