---
import { Font } from 'astro:assets';
import { getComponentsThemeCss } from '@utils/theme/theme';
import type { UIThemeName } from '@utils/theme/uiThemes';

import '@assets/css/tokens.css';
import '@assets/css/theme/theme.css';
import '@assets/css/main.css';

interface Props {
  title?: string;
  uiTheme?: UIThemeName;
}

const { title = 'Home page', uiTheme } = Astro.props;
const componentsThemeCss = getComponentsThemeCss(uiTheme);
---

<Font cssVariable="--font-roboto" preload />

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {componentsThemeCss && <style is:global set:html={componentsThemeCss} />}
    <slot />
  </body>
</html>
