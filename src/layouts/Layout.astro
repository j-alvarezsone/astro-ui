---
import { Font } from 'astro:assets';
import { getComponentsThemeCss } from '@utils/theme/theme';
import type { UIThemeName } from '@utils/theme/uiThemes';
import jasDarkLogo from '@assets/logo/JAS_transparent_logo.png';

import '@assets/css/tokens.css';
import '@assets/css/theme/theme.css';
import '@assets/css/main.css';
import { ClientRouter } from 'astro:transitions';
import type { NavbarAction, NavbarBrand, NavbarItem } from '@components/navigation/Navbar.astro';
import Navbar from '@components/navigation/Navbar.astro';

interface Props {
  title?: string;
  uiTheme?: UIThemeName;
}

const { title = 'Home page', uiTheme } = Astro.props;
const componentsThemeCss = getComponentsThemeCss(uiTheme);

const navbarBrand: NavbarBrand = {
  href: '/',
  image: {
    src: jasDarkLogo,
    alt: 'Haramain',
  },
};

const navbarItems: NavbarItem[] = [
  { kind: 'link', label: 'Home', href: '/' },
  { kind: 'link', label: 'Theme System', href: '/theme-system' },
  { kind: 'link', label: 'Query Guide', href: '/query-system' },
  { kind: 'link', label: 'Server Query', href: '/query-system/server-query' },
  { kind: 'link', label: 'Client Query', href: '/query-system/client-query' },
];

const navbarActions: NavbarAction[] = [
  { ariaLabel: 'Login account', icon: { name: 'mdi:account-circle-outline' } },
  { ariaLabel: 'Toggle dark mode', icon: { name: 'mdi:theme-light-dark' } },
];
---

<Font cssVariable="--font-roboto" preload />

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    {componentsThemeCss && <style is:global set:html={componentsThemeCss} />}
    <Navbar brand={navbarBrand} items={navbarItems} actions={navbarActions} />
    <slot />
  </body>
</html>
