{
  "name": "astro-ui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type:check": "pnpm astro check",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage",
    "generate:icons": "tsx ./scripts/generate-icon-names.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/vue": "^6.0.1",
    "astro": "^6.2.1",
    "astro-icon": "^1.1.5",
    "sharp": "^0.34.5",
    "typescript": "^6.0.2",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@astrojs/netlify": "^7.0.9",
    "@iconify-json/mdi": "^1.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro,vue}": "pnpm run lint"
  },
  "packageManager": "pnpm@10.33.2"
}
